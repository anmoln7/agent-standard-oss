#!/bin/bash
# absence-check — turn "I looked for X and did not find it" into a citable fact.
#
#   absence-check <pattern> [dir]     # one control; prints a verdict line
#   absence-check --controls [dir]    # the built-in control set (backups, auth, …)
#   absence-check --json <pattern> [dir]
#
# The most dangerous claim an audit makes is a confident absence. An agent asked
# what is missing will happily assert "there is no rate limiting" when it simply
# did not grep for the right thing. This does that grep deterministically: it
# records the pattern searched, the hit count, and up to a few paths, so a
# "not found" claim can cite a reproducible zero rather than the model's memory.
#
# The scope rule is the important part. A zero-hit result is NOT automatically
# NOT FOUND. Controls that live outside a source repo (backups, PITR, alert
# routing) are UNVERIFIED on a zero hit — UNLESS the repo ships infrastructure
# as code, in which case the repo owns that surface and the miss becomes a real
# NOT FOUND. Silence off the surface the repo owns is never reported as absent.
# The same rule applies to the tool itself: if a repo keeps all its code in a
# skipped dir (scripts/, tests/) so the scan saw no source at all, every verdict
# is UNVERIFIED — a NOT FOUND over an empty scope would be a false absence.
#
# What CONFIRMED means, and what it does not. CONFIRMED says a known signal for a
# control was matched — not that the control is correct, sufficient, or even real
# (a variable named `authenticate` counts). Just as important: a control that IS
# present but written in a form these patterns do not match reports NOT_FOUND — a
# false absence this tool cannot rule out. So NOT_FOUND means "no known signal in
# reviewed scope," never "the control does not exist." Treat every verdict as a
# pointer to go look, not a proof.
#
# The --controls set (auth, rate-limit, input-valid, backups, alerting, secrets)
# is a starting convention lifted from common web-app controls, not an audited or
# complete list. It is meant to be edited per repo. Patterns favour precision over
# recall on purpose: a loose pattern that matches a word inside another word
# (`joi` inside `join`) manufactures false CONFIRMEDs, which is the worse failure
# for an absence tool. When in doubt, miss and report NOT_FOUND.
#
# Read-only: greps and reports, writes nothing. Exit 0 always (a verdict is not
# a failure); use the printed state, not the exit code.
set -uo pipefail

# ── argument parse ───────────────────────────────────────────────────────────
json=0
[ "${1:-}" = "--json" ] && { json=1; shift; }

mode="one"
[ "${1:-}" = "--controls" ] && { mode="controls"; shift; }

# grep across a repo's text files, excluding the usual noise. Prints matching
# "path:line:text" lines; awk keeps it macOS/Linux-safe (no grep -r --include).
scan(){ # scan <pattern> <dir>  → matching lines on stdout
  local pat="$1" dir="$2"
  # Scope to application SOURCE, not the whole tree. A word like "backup" in a
  # planning doc, or a control name in a test file, is not the control itself; on
  # a real repo those hits dwarf the real ones — a test suite that exercises retry
  # or secret-scrubbing buries the actual source under test-file citations. So
  # restrict to source extensions and skip docs, build tooling, and tests (across
  # JS/Python/Go/Rust/Ruby/Java conventions). Exclude this script itself — its
  # control patterns are written here as literals and would self-match.
#
# One class of false CONFIRMED remains that scoping cannot fix: a control name
# used as DATA rather than as a control — "datadog" and "pagerduty" listed as
# labels in an integrations picker, say. grep cannot tell the string from the
# usage, so treat a CONFIRMED as "a known signal appears here", then read the
# cited line to see whether it is the control or just its name.
  grep -RInE --binary-files=without-match \
    --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=vendor \
    --exclude-dir=.venv --exclude-dir=venv --exclude-dir=dist --exclude-dir=build \
    --exclude-dir=.next --exclude-dir=target --exclude-dir=.terraform \
    --exclude-dir=.angular --exclude-dir=.svelte-kit --exclude-dir=.nuxt \
    --exclude-dir=.cache --exclude-dir=coverage --exclude-dir=.turbo \
    --exclude-dir=.readiness-audit \
    --exclude-dir=docs --exclude-dir=doc --exclude-dir=tools --exclude-dir=scripts \
    --exclude-dir=fixtures --exclude-dir=__fixtures__ --exclude-dir=e2e \
    --exclude-dir=test-corpus --exclude-dir=testdata --exclude-dir=__mocks__ \
    --exclude-dir=tests --exclude-dir=test --exclude-dir=__tests__ \
    --exclude-dir=spec --exclude-dir=mod_test \
    --exclude-dir=examples --exclude-dir=example --exclude-dir=demo \
    --exclude-dir=chunks --exclude-dir=Resources --exclude-dir=.output \
    --exclude-dir=.obsidian --exclude-dir=bower_components --exclude-dir=Pods \
    --include='*.ts' --include='*.tsx' --include='*.js' --include='*.jsx' \
    --include='*.mjs' --include='*.cjs' --include='*.vue' --include='*.svelte' \
    --include='*.py' --include='*.go' --include='*.rb' --include='*.java' \
    --include='*.kt' --include='*.php' --include='*.cs' --include='*.rs' \
    --include='*.scala' --include='*.sql' --include='*.prisma' \
    --exclude='*.test.*' --exclude='*.spec.*' --exclude='test_*.py' \
    --exclude='*_test.py' --exclude='*_test.go' --exclude='*_test.rs' \
    --exclude='*_test.rb' --exclude='*Test.java' --exclude='*Test.kt' \
    --exclude='tests.py' --exclude='tests.js' --exclude='conftest.py' \
    --exclude='*.map' --exclude='*.min.js' --exclude='*.min.mjs' \
    --exclude='*.bundle.*' --exclude='chunk-*' --exclude='*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.mjs' \
    -- "$pat" "$dir" 2>/dev/null
}

# Does the repo own infrastructure? (IaC / deploy config present.)  Decides
# whether an off-source control's absence is NOT FOUND vs UNVERIFIED.
owns_infra(){ # owns_infra <dir>  → exit 0 if the repo ships IaC
  local dir="$1"
  # filename check below is the reliable signal; the content grep is a fallback.
  find "$dir" -type f \( -name '*.tf' -o -name '*.bicep' -o -name 'Dockerfile*' \
    -o -name 'docker-compose.y*ml' -o -name 'serverless.y*ml' \) \
    -not -path '*/.git/*' -print -quit 2>/dev/null | grep -q . && return 0
  return 1
}

# Did the scan have any application source to look at? If a repo keeps all its
# code in scripts/ or tests/ (both excluded), the scan sees nothing — and a
# NOT_FOUND over an empty scope is a false absence: the tool looked at nothing
# and reported "not there". This applies the scope rule to the tool itself.
has_source(){ # has_source <dir>  → exit 0 if scan() would see at least one file
  # No pipe to head here: head closing early gives scan a SIGPIPE, which under
  # `pipefail` makes the pipeline fail even when there was output. Count instead.
  local n
  n="$(scan '.' "$dir" | grep -c . )"
  [ "$n" -gt 0 ]
}

# state <hitcount> <off_source> <dir> <has_src>  → CONFIRMED | NOT_FOUND | UNVERIFIED
verdict(){
  local hits="$1" off="$2" dir="$3" has_src="$4"
  if [ "$hits" -gt 0 ]; then echo "CONFIRMED"; return; fi
  # zero hits with no source in scope: silence over nothing proves nothing.
  if [ "$has_src" = "no" ]; then echo "UNVERIFIED"; return; fi
  # zero hits. off-source controls need the repo to own the surface.
  if [ "$off" = "off" ] && ! owns_infra "$dir"; then echo "UNVERIFIED"; else echo "NOT_FOUND"; fi
}

# report <label> <pattern> <dir> <off_source>
# Set once per run (in the caller) so has_source() isn't recomputed per control.
HAS_SRC="yes"

report(){
  local label="$1" pat="$2" dir="$3" off="$4"
  local matches count first state
  matches="$(scan "$pat" "$dir")"
  count="$(printf '%s' "$matches" | grep -c . )"
  state="$(verdict "$count" "$off" "$dir" "$HAS_SRC")"
  first="$(printf '%s\n' "$matches" | head -3 | cut -d: -f1-2 | paste -sd'; ' -)"
  if [ "$json" = 1 ]; then
    printf '{"control":"%s","pattern":"%s","hits":%s,"state":"%s","paths":"%s"}\n' \
      "$label" "$pat" "$count" "$state" "$first"
  else
    printf '%-14s %-11s hits=%-3s %s\n' "$label" "$state" "$count" "$first"
  fi
}

dir="${2:-.}"
[ "$mode" = "one" ] && dir="${2:-.}"

if [ "$mode" = "controls" ]; then
  dir="${1:-.}"
  has_source "$dir" || HAS_SRC="no"
  # control | pattern | on/off-source (off = normally lives outside app code)
  report "auth"        '(requireAuth|isAuthenticated|ensureLoggedIn|@login_required|authenticate\(|def authenticate|InstalledAppFlow|OAuth2?Flow)' "$dir" on
  report "rate-limit"  '(rateLimit|rate_limit|RateLimiter|express-rate-limit)'                     "$dir" on
  report "input-valid" '(from .?zod|from .?joi|from .?yup|import zod|pydantic|express-validator|z\.object|\.safeParse\()' "$dir" on
  report "backups"     '(pg_dump|mysqldump|pg_basebackup|\bPITR\b|wal-g|barman)'                     "$dir" off
  report "alerting"    '(pagerduty|opsgenie|@sentry|datadog|prometheus|createAlert)'               "$dir" off
  report "secrets-mgr" '(hashicorp/vault|secretsmanager|getSecret|sops|doppler|service_account|client_secret|oauth2\.credentials|InstalledAppFlow|_CREDENTIALS)' "$dir" off
  exit 0
fi

pat="${1:-}"
[ -n "$pat" ] || { echo "usage: absence-check <pattern> [dir]  |  absence-check --controls [dir]"; exit 1; }
has_source "$dir" || HAS_SRC="no"
# a bare pattern is treated as on-source (its absence is NOT FOUND on zero hits).
report "$pat" "$pat" "$dir" on
