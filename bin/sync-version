#!/bin/bash
# sync-version — one version, derived everywhere. The VERSION file at the repo
# root is the single source of truth; this writes it into every file that also
# carries the string so they can't drift by hand-edit:
#   .claude-plugin/plugin.json, .claude-plugin/marketplace.json,
#   .codex-plugin/plugin.json, .cursor-plugin/plugin.json,
#   .cursor-plugin/marketplace.json, README.md
#
#   sync-version           # rewrite the derived files from VERSION
#   sync-version --check    # exit non-zero if any derived file is out of sync
#                           # (writes nothing — this is the CI gate)
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF_DIR/.." && pwd)"

VER="$(tr -d '[:space:]' < "$ROOT/VERSION")"
if ! printf '%s' "$VER" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$'; then
  echo "sync-version: VERSION is not semver: '$VER'" >&2
  exit 2
fi

check=""
[ "${1:-}" = "--check" ] && check=1

# Every JSON manifest that carries "version": "X.Y.Z". The first such field in
# each file is the plugin version (host manifests put it at the top level).
json_files="
.claude-plugin/plugin.json
.claude-plugin/marketplace.json
.codex-plugin/plugin.json
.cursor-plugin/plugin.json
.cursor-plugin/marketplace.json
"
readme="$ROOT/README.md"

# The one README occurrence is the CI-example pin: agent-standard-oss@vX.Y.Z
# JSON files carry "version": "X.Y.Z". Rewrite in place (portable sed -i).
sed_i() {  # sed_i <expr> <file>  — BSD and GNU compatible
  sed "$1" "$2" > "$2.tmp" && mv "$2.tmp" "$2"
}

drift=0
report() { echo "version drift: $1 has '$2', VERSION has '$VER'" >&2; drift=1; }

# the version field in each JSON manifest (first occurrence = the plugin version)
for rel in $json_files; do
  f="$ROOT/$rel"
  [ -f "$f" ] || { echo "sync-version: missing $rel" >&2; drift=1; continue; }
  cur="$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
  if [ -n "$check" ]; then
    [ "$cur" = "$VER" ] || report "$rel" "$cur"
  else
    sed_i "s/\"version\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"version\": \"$VER\"/" "$f"
  fi
done

# README.md CI-example pin
cur="$(grep -o 'agent-standard-oss@v[0-9][0-9A-Za-z.-]*' "$readme" | head -1 | sed 's/.*@v//')"
if [ -n "$check" ]; then
  [ "$cur" = "$VER" ] || report "README.md" "$cur"
else
  sed_i "s/agent-standard-oss@v[0-9][0-9A-Za-z.-]*/agent-standard-oss@v$VER/g" "$readme"
fi

if [ -n "$check" ]; then
  [ "$drift" -eq 0 ] && echo "sync-version: all derived files match VERSION ($VER)"
  exit "$drift"
fi
echo "sync-version: wrote $VER to all plugin manifests + README.md"
